# auth-server-go 环境变量示例（复制为 .env 或写进 systemd；真实部署值一律不放仓库）
# 与旧 Node 实现同名同默认，例外处已注明。

# 监听（新服务默认回环 + 19260；旧实现默认 0.0.0.0:3200）
HOST=127.0.0.1
PORT=19260

# Redis（会话唯一存储；测试请换独立 DB，例如 15）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# 数据目录：oidc-keys.json / totp-secret.json / totp-pending.json / jwt-secret / clients.json
# 默认取当前工作目录，部署时显式指定。
DATA_DIR=/var/lib/auth-server-go

# OIDC issuer：所有端点 URL 由它拼接，必须是绝对 URL；不得硬编码真实域名
ISSUER=http://127.0.0.1:19260

# 身份（唯一来源）：sub / preferred_username / X-Auth-User；展示名为 name
SSO_SUBJECT=user
SSO_DISPLAY_NAME=user

# 会话滑动过期天数
SESSION_DAYS=7

# 直接写 JWT 密钥；留空则读 <DATA_DIR>/jwt-secret（缺则生成 0600）
JWT_SECRET=

# 内部接口共享令牌文件（0600 自动生成）；INTERNAL_TOKEN 可直接覆盖值，不落日志不返回
INTERNAL_TOKEN_FILE=
INTERNAL_TOKEN=

# 登录来源 GeoIP 解析接口；{ip} 会被替换
AUTH_GEOIP_URL=https://ip-api.com/json/{ip}?fields=status,country,regionName,city

# 登录页跨域回跳白名单（逗号分隔域名根）；留空仅允许同源，绝不回退成任意域
ALLOWED_REDIRECT_ROOTS=

# 撤销后异步通知网关的 back-channel 地址（loopback 仅本机）
GATEWAY_BACKCHANNEL_URL=http://127.0.0.1:18920/_auth/backchannel-logout

# access_token 有效期（秒），下限 60
ACCESS_TTL_SEC=900
